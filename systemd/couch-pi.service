[Unit]
Description=Pi Couch web client for pi sessions
After=network-online.target

[Service]
# The exec'd pi shim needs node (linuxbrew) on PATH; ~/.local/bin carries pi itself.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# addr, origin and friends come from ~/.config/pi-couch/config.toml
# (see pi-couch.example.toml in the repo). Flags override config.
# Secrets (access token, memory secret) live in one optional env file,
# one KEY=value per line, kept out of this unit and out of the repo.
EnvironmentFile=-%h/.config/pi-couch/env
ExecStart=%h/.local/bin/couch-pi
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
