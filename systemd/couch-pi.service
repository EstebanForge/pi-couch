[Unit]
Description=Couch Pi web client for pi sessions
After=network-online.target

[Service]
# The exec'd pi shim needs node (linuxbrew) on PATH; ~/.local/bin carries pi itself.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/couch-pi --addr 127.0.0.1:8090 --origin https://box.example.ts.net:8443
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
