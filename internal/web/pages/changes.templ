package pages

import (
	"fmt"
	"path/filepath"
	"strconv"
	"strings"

	"github.com/EstebanForge/couch-pi/internal/git"
	"github.com/EstebanForge/couch-pi/internal/pi"
)

// Changes is the R tab: repo discovery, working-tree file cards, and a
// per-file diff view (R2/R4).
templ Changes(meta pi.SessionMeta, repo string, branch string, files []git.FileChange, selFile string, diffText string, truncated bool) {
	<!doctype html>
	<html lang="en" data-theme="coffee">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ meta.DisplayName() } - changes</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/coffee.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script src="/static/js/datastar.js" defer></script>
			<script src="/static/js/main.js" defer></script>
		</head>
		<body>
			<header>
				<a class="back" href={ templ.URL("/sessions/" + meta.Key) }>&larr; Chat</a>
				<h1>{ meta.DisplayName() }</h1>
				<p class="sub">
					if repo != "" {
						<span>{ filepath.Base(repo) }</span>
					}
					if branch != "" {
						<span>{ branch }</span>
					}
				</p>
			</header>
			@TabStrip(meta.Key, "chg")
			<main class="changes">
				if repo == "" {
					<div class="notice">Not a git repository.</div>
				} else if selFile != "" {
					<a class="back" href={ templ.URL("/sessions/" + meta.Key + "/changes") }>&larr; All changes</a>
					<h2>{ selFile }</h2>
					@DiffView(diffText, truncated)
					<div id="cmt-sheet" class="sheet" hidden data-key={ meta.Key } data-file={ selFile }>
						<div class="sheet-ref" id="cmt-ref"></div>
						<textarea id="cmt-text" placeholder="Add feedback comment..." rows="3"></textarea>
						<div class="sheet-actions">
							<button id="cmt-cancel" type="button">Cancel</button>
							<button id="cmt-save" type="button" class="primary">Save</button>
						</div>
					</div>
				} else {
					<div id="file-list" data-on-load={ sseChanges(meta.Key) }>
						@FileCards(meta.Key, files)
					</div>
				}
			</main>
		</body>
	</html>
}

// FileCards is the live-patched working-tree list.
templ FileCards(key string, files []git.FileChange) {
	if len(files) == 0 {
		<div class="clean">Working tree clean.</div>
	}
	for _, f := range files {
		if f.Binary {
			<div class="file">
				<span class={ "chip", "l-" + f.Label() }>{ f.Label() }</span>
				<span class="path">{ f.Path }</span>
				<span class="stat">binary</span>
			</div>
		} else if f.Label() == "new" {
			<div class="file">
				<span class={ "chip", "l-" + f.Label() }>{ f.Label() }</span>
				<span class="path">{ f.Path }</span>
			</div>
		} else {
			<div class="file">
				<a href={ templ.URL("/sessions/" + key + "/changes?file=" + f.Path) }>
					<span class={ "chip", "l-" + f.Label() }>{ f.Label() }</span>
					<span class="path">{ f.Path }</span>
					<span class="stat">{ fmt.Sprintf("+%d -%d", f.Added, f.Deleted) }</span>
				</a>
			</div>
		}
	}
}

// diffLine is one rendered diff row. No is the current-file position:
// additions and context carry their new-file number, deletions carry the
// slot they occupied (numbers shift anyway; the text is what matters).
type diffLine struct {
	kind string
	text string
	no   int
}

func parseDiff(diffText string) []diffLine {
	lines := strings.Split(strings.TrimRight(diffText, "\n"), "\n")
	out := make([]diffLine, 0, len(lines))
	newNo := 0
	for _, line := range lines {
		switch {
		case strings.HasPrefix(line, "@@"):
			out = append(out, diffLine{kind: "hunk", text: line})
			newNo = hunkNewStart(line)
		case strings.HasPrefix(line, "+++") || strings.HasPrefix(line, "---"):
			out = append(out, diffLine{kind: "meta", text: line})
		case strings.HasPrefix(line, "+"):
			newNo++
			out = append(out, diffLine{kind: "add", no: newNo, text: line})
		case strings.HasPrefix(line, "-"):
			out = append(out, diffLine{kind: "del", no: newNo + 1, text: line})
		default:
			newNo++
			out = append(out, diffLine{kind: "ctx", no: newNo, text: line})
		}
	}
	return out
}

// hunkNewStart extracts N from "@@ -a,b +N,c @@ ..."; 0 on a surprise shape.
func hunkNewStart(line string) int {
	fields := strings.Fields(line)
	if len(fields) < 3 {
		return 0
	}
	num := strings.TrimPrefix(fields[2], "+")
	if i := strings.Index(num, ","); i >= 0 {
		num = num[:i]
	}
	n, err := strconv.Atoi(num)
	if err != nil {
		return 0
	}
	return n
}

// DiffView renders one diff. Every code line is a comment button carrying
// its file position; the draft sheet opens from the page island.
templ DiffView(diffText string, truncated bool) {
	if diffText == "" {
		<div class="clean">No text diff.</div>
	} else {
		<pre class="diff">
			for _, l := range parseDiff(diffText) {
				if l.kind == "hunk" || l.kind == "meta" {
					<span class={ "dl", l.kind }>{ l.text }</span>
				} else {
					<button type="button" class={ "dl", l.kind } data-cmt-line={ fmt.Sprint(l.no) } data-text={ l.text }>{ l.text }</button>
				}
			}
		</pre>
	}
	if truncated {
		<div class="notice">Diff truncated at 2000 lines.</div>
	}
}

func sseChanges(key string) string {
	return `@get('/stream/changes/` + key + `')`
}
