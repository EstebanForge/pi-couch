package pages

import (
	"github.com/EstebanForge/couch-pi/internal/web"
	"fmt"
	"net/url"
	"path/filepath"
	"strconv"
	"strings"

	"github.com/EstebanForge/couch-pi/internal/git"
	"github.com/EstebanForge/couch-pi/internal/pi"
)

// Changes is the R tab: repo discovery, working-tree file cards, and a
// per-file diff view (R2/R4).
templ Changes(meta pi.SessionMeta, repo string, branch string, files []git.FileChange, selFile string, diffText string, truncated bool) {
	<!doctype html>
	<html lang="en" data-theme="dracula">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ meta.DisplayName() } - changes</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/daisyui.css" integrity="sha384-7aEtEHaaQlvolkHZ6DyoGlsNOFe/zuR0er02iYikX9npKr+C4ANk7t3C7wzeItRf" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/theme/dracula.css" integrity="sha384-5wuHXUrEEjdxHCFM30I9idvob9Li9ycYna0ziWfDPkAHDFijPEdeecw3xNvf4dzA" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ web.AssetPath("/static/app.css") }/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3" integrity="sha384-aJ9rL4k6lF+91guGvUFVSkpIcge7Zd9EiI4TQDLoK9kFaFJgKHgjEXVvG/qA5COj" crossorigin="anonymous"></script>
			<script src="/static/js/datastar.js" defer></script>
			<script src={ web.AssetPath("/static/js/main.js") } defer></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-3 pb-2">
				<a class="link link-hover text-sm opacity-60" href={ templ.URL("/sessions/" + meta.Key) }>&larr; Chat</a>
				<h1 class="text-xl font-bold truncate">{ meta.DisplayName() }</h1>
				<div class="flex items-center gap-2 text-sm opacity-70">
					if repo != "" {
						<span class="font-mono">{ filepath.Base(repo) }</span>
					}
					if branch != "" {
						<span class="badge badge-ghost badge-sm font-mono">{ branch }</span>
					}
				</div>
			</header>
			@TabStrip(meta.Key, "chg")
			<main class="px-3 pb-24">
				if repo == "" {
					<div class="alert alert-warning py-2 px-3 text-sm rounded-xl"><span>Not a git repository.</span></div>
				} else if selFile != "" {
					<a class="link link-hover text-sm opacity-60" href={ templ.URL("/sessions/" + meta.Key + "/changes") }>&larr; All changes</a>
					<h2 class="font-mono text-sm font-semibold mt-1 truncate">{ selFile }</h2>
					@DiffView(diffText, truncated)
					<div id="cmt-sheet" class="fixed bottom-0 inset-x-0 z-50 bg-base-200 rounded-t-2xl p-3" hidden data-key={ meta.Key } data-file={ selFile }>
						<div class="text-sm opacity-70" id="cmt-ref"></div>
						<textarea id="cmt-text" placeholder="Add feedback comment..." rows="3"
							class="textarea w-full bg-base-100 rounded-xl"></textarea>
						<div class="flex justify-end gap-2">
							<button id="cmt-cancel" type="button" class="btn btn-ghost btn-sm">Cancel</button>
							<button id="cmt-save" type="button" class="btn btn-primary btn-sm">Save</button>
						</div>
					</div>
				} else {
					<div id="file-list" class="flex flex-col gap-2" data-on-load={ sseChanges(meta.Key) }>
						@FileCards(meta.Key, files)
					</div>
				}
			</main>
		</body>
	</html>
}

// FileCards is the live-patched working-tree list.
templ FileCards(key string, files []git.FileChange) {
	if len(files) == 0 {
		<div class="text-sm opacity-60 text-center py-8">Working tree clean.</div>
	}
	for _, f := range files {
		if f.Binary {
			<div class="card bg-base-200 rounded-xl shadow-none">
				<div class="card-body p-3 flex-row items-center gap-2">
					<span class={ "badge badge-sm shrink-0", labelBadge(f.Label()) }>{ f.Label() }</span>
					<span class="font-mono text-sm truncate min-w-0">{ f.Path }</span>
					<span class="text-xs opacity-60 ml-auto shrink-0">binary</span>
				</div>
			</div>
		} else if f.Label() == "new" {
			<div class="card bg-base-200 rounded-xl shadow-none">
				<div class="card-body p-3 flex-row items-center gap-2">
					<span class={ "badge badge-sm shrink-0", labelBadge(f.Label()) }>{ f.Label() }</span>
					<span class="font-mono text-sm truncate min-w-0">{ f.Path }</span>
				</div>
			</div>
		} else {
			<div class="card bg-base-200 rounded-xl shadow-none">
				<a href={ templ.URL("/sessions/" + url.PathEscape(key) + "/changes?file=" + url.QueryEscape(f.Path)) } class="card-body p-3 flex-row items-center gap-2">
					<span class={ "badge badge-sm shrink-0", labelBadge(f.Label()) }>{ f.Label() }</span>
					<span class="font-mono text-sm truncate min-w-0">{ f.Path }</span>
					<span class="text-xs opacity-60 ml-auto shrink-0">{ fmt.Sprintf("+%d -%d", f.Added, f.Deleted) }</span>
				</a>
			</div>
		}
	}
}

// labelBadge maps a FileChange label to a daisyUI badge variant.
func labelBadge(label string) string {
	switch label {
	case "mod":
		return "badge-warning"
	case "new":
		return "badge-success"
	case "del":
		return "badge-error"
	case "ren":
		return "badge-info"
	default:
		return "badge-ghost"
	}
}

// diffLine is one rendered diff row. No is the current-file position:
// additions and context carry their new-file number, deletions carry the
// slot they occupied (numbers shift anyway; the text is what matters).
type diffLine struct {
	kind string
	text string
	no   int
}

func parseDiff(diffText string) []diffLine {
	lines := strings.Split(strings.TrimRight(diffText, "\n"), "\n")
	out := make([]diffLine, 0, len(lines))
	newNo := 0
	inHeader := true
	for _, line := range lines {
		switch {
		case strings.HasPrefix(line, "@@"):
			inHeader = false
			out = append(out, diffLine{kind: "hunk", text: line})
			newNo = hunkNewStart(line)
		case inHeader && (strings.HasPrefix(line, "+++") || strings.HasPrefix(line, "---")):
			// File header only: mid-hunk a removed "-- x" line also starts
			// with "--" but is content, not metadata.
			out = append(out, diffLine{kind: "meta", text: line})
		case line == "\\ No newline at end of file":
			out = append(out, diffLine{kind: "meta", text: line})
		case strings.HasPrefix(line, "+"):
			newNo++
			out = append(out, diffLine{kind: "add", no: newNo, text: line})
		case strings.HasPrefix(line, "-"):
			out = append(out, diffLine{kind: "del", no: newNo + 1, text: line})
		default:
			newNo++
			out = append(out, diffLine{kind: "ctx", no: newNo, text: line})
		}
	}
	return out
}

// hunkNewStart extracts N from "@@ -a,b +N,c @@ ..."; 0 on a surprise shape.
func hunkNewStart(line string) int {
	fields := strings.Fields(line)
	if len(fields) < 3 {
		return 0
	}
	num := strings.TrimPrefix(fields[2], "+")
	if i := strings.Index(num, ","); i >= 0 {
		num = num[:i]
	}
	n, err := strconv.Atoi(num)
	if err != nil {
		return 0
	}
	return n
}

// DiffView renders one diff. Every code line is a comment button carrying
// its file position; the draft sheet opens from the page island.
templ DiffView(diffText string, truncated bool) {
	if diffText == "" {
		<div class="text-sm opacity-60 text-center py-8">No text diff.</div>
	} else {
		<pre class="diff bg-base-200 rounded-xl p-2 text-xs overflow-x-auto mt-2">
			for _, l := range parseDiff(diffText) {
				if l.kind == "hunk" || l.kind == "meta" {
					<span class={ "dl", l.kind }>{ l.text }</span>
				} else {
					<button type="button" class={ "dl", l.kind } data-cmt-line={ fmt.Sprint(l.no) } data-text={ l.text }>{ l.text }</button>
				}
			}
		</pre>
	}
	if truncated {
		<div class="alert alert-warning py-2 px-3 text-sm rounded-xl mt-2"><span>Diff truncated at 2000 lines.</span></div>
	}
}

func sseChanges(key string) string {
	// The key lands inside a JS expression; strconv.Quote keeps a filename
	// with quotes or backslashes from breaking out.
	return "@get(" + strconv.Quote("/stream/changes/"+url.PathEscape(key)) + ")"
}
