package pages

import (
	"fmt"

	"github.com/EstebanForge/couch-pi/internal/pi"
)

templ Transcript(meta pi.SessionMeta, items []pi.ViewItem, driver string, notice string) {
	<!doctype html>
	<html lang="en" data-theme="coffee">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ meta.DisplayName() }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/coffee.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script src="/static/js/datastar.js" defer></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-3 pb-2">
				<a class="link link-hover text-sm opacity-60" href="/">&larr; Sessions</a>
				<div class="flex items-center gap-2">
					<h1 class="text-xl font-bold truncate min-w-0 flex-1">{ meta.DisplayName() }</h1>
					<span id="driver-badge" class="shrink-0">@DriverBadge(driver)</span>
				</div>
				<p class="text-sm opacity-60 truncate">{ meta.Cwd }</p>
				<div class="flex items-center gap-2 text-sm opacity-80 flex-wrap">
					if meta.Model != "" {
						<span>{ meta.Model }</span>
					}
					if meta.TotalTokens > 0 {
						<span>{ tok(meta.TotalTokens) }</span>
					}
					if meta.TotalCost > 0 {
						<span>{ fmt.Sprintf("$%.2f", meta.TotalCost) }</span>
					}
				</div>
			</header>
			@TabStrip(meta.Key, "chat")
			if notice != "" {
				<div class="alert alert-warning py-2 px-3 text-sm mx-3 rounded-xl"><span>{ notice }</span></div>
			}
			<div id="stop-box">@StopForm(meta.Key, driver)</div>
			<main class="flex flex-col gap-3 px-3 pb-60">
				<div id="chat" data-on-load={ sseTranscript(meta.Key) }>
					@TranscriptItems(items)
				</div>
			</main>
			<div class="fixed bottom-14 inset-x-0 z-40 bg-base-100 border-t border-base-300 p-2 flex items-end gap-2">
				<form method="post" action={ templ.URL("/sessions/" + meta.Key + "/prompt") } class="flex-1 flex items-end gap-2">
					<textarea name="text" required placeholder="Steer the agent"
						class="textarea w-full rounded-xl bg-base-200 min-h-11 leading-6"></textarea>
					<button class="btn btn-primary rounded-xl" type="submit">Send</button>
				</form>
			</div>
		</body>
	</html>
}

// TranscriptItems is the live-patched transcript fragment.
templ TranscriptItems(items []pi.ViewItem) {
	for _, it := range items {
		switch it.Kind {
		case "user":
			<div class="chat chat-end">
				<div class="chat-bubble bg-base-300 text-base-content rounded-2xl">
					<p class="whitespace-pre-wrap">{ it.Text }</p>
					if it.Images > 0 {
						<span class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d image(s)", it.Images) }</span>
					}
				</div>
			</div>
		case "text":
			<div class="chat chat-start">
				<div class="chat-bubble bg-base-200 rounded-2xl">
					<p class="whitespace-pre-wrap">{ it.Text }</p>
				</div>
			</div>
		case "thinking":
			if it.Redacted {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl">
					<summary class="collapse-title text-sm py-1 min-h-0 opacity-60">thinking (redacted)</summary>
				</details>
			} else {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl">
					<summary class="collapse-title text-sm py-1 min-h-0 opacity-60">thinking</summary>
					<div class="collapse-content"><p class="text-sm whitespace-pre-wrap opacity-80">{ it.Text }</p></div>
				</details>
			}
		case "tool_call":
			<div class="flex items-center gap-2 text-sm pl-1">
				<span class="badge badge-ghost badge-sm font-mono shrink-0">{ it.ToolName }</span>
				<code class="opacity-60 truncate min-w-0">{ it.Text }</code>
			</div>
		case "tool_result":
			if it.IsError {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl border border-error/40">
					<summary class="collapse-title text-sm py-1 min-h-0 text-error">{ it.ToolName + " error" }</summary>
					<div class="collapse-content"><pre class="text-xs whitespace-pre-wrap overflow-x-auto">{ it.Text }</pre></div>
				</details>
			} else {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl">
					<summary class="collapse-title text-sm py-1 min-h-0 opacity-60">{ it.ToolName }</summary>
					<div class="collapse-content"><pre class="text-xs whitespace-pre-wrap overflow-x-auto opacity-80">{ it.Text }</pre></div>
				</details>
			}
		case "marker", "bash", "custom":
			<div class="text-xs opacity-50 text-center uppercase tracking-wider">{ it.Text }</div>
		}
	}
}

// DriverBadge renders inside #driver-badge; empty status clears it.
templ DriverBadge(status string) {
	if status != "" {
		<span class={ "badge badge-sm gap-1 shrink-0", badgeClass(status) }>
			<span class={ "status status-xs", statusColor(status) }></span>
			{ status }
		</span>
	}
}

// StopForm renders inside #stop-box. Ctrl-C on an idle pi prompt is
// destructive (it can exit pi), so the button exists only while the
// driver reports working or blocked.
templ StopForm(key string, status string) {
	if status == "working" || status == "blocked" {
		<form method="post" action={ templ.URL("/sessions/" + key + "/stop") } class="px-3">
			<button class="btn btn-error btn-sm rounded-full" type="submit">Stop (Ctrl-C)</button>
		</form>
	}
}

func sseTranscript(key string) string {
	return `@get('/stream/transcript/` + key + `')`
}
