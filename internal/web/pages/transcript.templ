package pages

import (
	"github.com/EstebanForge/couch-pi/internal/web"
	"fmt"
	"net/url"
	"strconv"

	"github.com/EstebanForge/couch-pi/internal/pi"
)

templ Transcript(meta pi.SessionMeta, items []pi.ViewItem, driver string, notice string) {
	<!doctype html>
	<html lang="en" data-theme="dracula">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ meta.DisplayName() }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/daisyui.css" integrity="sha384-7aEtEHaaQlvolkHZ6DyoGlsNOFe/zuR0er02iYikX9npKr+C4ANk7t3C7wzeItRf" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/theme/dracula.css" integrity="sha384-5wuHXUrEEjdxHCFM30I9idvob9Li9ycYna0ziWfDPkAHDFijPEdeecw3xNvf4dzA" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ web.AssetPath("/static/app.css") }/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3" integrity="sha384-aJ9rL4k6lF+91guGvUFVSkpIcge7Zd9EiI4TQDLoK9kFaFJgKHgjEXVvG/qA5COj" crossorigin="anonymous"></script>
			<script src="/static/js/datastar.js" defer></script>
			<script src={ web.AssetPath("/static/js/main.js") } defer></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-3 pb-2">
				<a class="link link-hover text-sm opacity-60" href="/">&larr; Sessions</a>
				<div class="flex items-center gap-2">
					<h1 class="text-xl font-bold truncate min-w-0 flex-1">{ meta.DisplayName() }</h1>
					<span id="driver-badge" class="shrink-0">@DriverBadge(driver)</span>
				</div>
				<p class="text-sm opacity-60 truncate">{ meta.Cwd }</p>
				<div class="flex items-center gap-2 text-sm opacity-80 flex-wrap">
					if meta.Model != "" {
						<span>{ meta.Model }</span>
					}
					if meta.TotalTokens > 0 {
						<span>{ tok(meta.TotalTokens) }</span>
					}
					if meta.TotalCost > 0 {
						<span>{ fmt.Sprintf("$%.2f", meta.TotalCost) }</span>
					}
				</div>
			</header>
			@TabStrip(meta.Key, "chat")
			if notice != "" {
				<div class="alert alert-warning py-2 px-3 text-sm mx-3 rounded-xl"><span>{ notice }</span></div>
			}
			<div id="stop-box">@StopForm(meta.Key, driver)</div>
			@SearchBox()
			<main class="flex flex-col gap-3 px-3 pb-60">
				<div id="chat" data-on-load={ sseTranscript(meta.Key) }>
					@TranscriptItems(items)
				</div>
			</main>
			<div class="fixed bottom-14 inset-x-0 z-40 bg-base-100 border-t border-base-300 p-2 flex items-end gap-2">
				<form method="post" action={ templ.URL("/sessions/" + meta.Key + "/prompt") } class="flex-1 flex items-end gap-2">
					<textarea name="text" required placeholder="Steer the agent"
						class="textarea w-full rounded-xl bg-base-200 min-h-11 leading-6"></textarea>
					<button class="btn btn-primary rounded-xl" type="submit">Send</button>
				</form>
			</div>
			<div class="fixed bottom-[7.25rem] inset-x-0 z-40 px-2">
				@ModelPicker(meta.Key, meta.Model)
			</div>
		</body>
	</html>
}

// TranscriptItems is the live-patched transcript fragment.
templ TranscriptItems(items []pi.ViewItem) {
	for _, it := range items {
		switch it.Kind {
		case "user":
			<div class="chat chat-end">
				<div class="chat-bubble bg-base-300 text-base-content rounded-2xl">
					<p class="whitespace-pre-wrap">{ it.Text }</p>
					if it.Images > 0 {
						<span class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d image(s)", it.Images) }</span>
					}
				</div>
			</div>
		case "text":
			<div class="chat chat-start">
				<div class="chat-bubble bg-base-200 rounded-2xl">
					<p class="whitespace-pre-wrap">{ it.Text }</p>
				</div>
			</div>
		case "thinking":
			if it.Redacted {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl">
					<summary class="collapse-title text-sm py-1 min-h-0 opacity-60">thinking (redacted)</summary>
				</details>
			} else {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl">
					<summary class="collapse-title text-sm py-1 min-h-0 opacity-60">thinking</summary>
					<div class="collapse-content"><p class="text-sm whitespace-pre-wrap opacity-80">{ it.Text }</p></div>
				</details>
			}
		case "tool_call":
			<div class="flex items-center gap-2 text-sm pl-1">
				<span class="badge badge-ghost badge-sm font-mono shrink-0">{ it.ToolName }</span>
				<code class="opacity-60 truncate min-w-0">{ it.Text }</code>
			</div>
		case "tool_result":
			if it.IsError {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl border border-error/40">
					<summary class="collapse-title text-sm py-1 min-h-0 text-error">{ it.ToolName + " error" }</summary>
					<div class="collapse-content"><pre class="text-xs whitespace-pre-wrap overflow-x-auto">{ it.Text }</pre></div>
				</details>
			} else {
				<details class="collapse collapse-arrow bg-base-200/60 rounded-xl">
					<summary class="collapse-title text-sm py-1 min-h-0 opacity-60">{ it.ToolName }</summary>
					<div class="collapse-content"><pre class="text-xs whitespace-pre-wrap overflow-x-auto opacity-80">{ it.Text }</pre></div>
				</details>
			}
		case "marker", "bash", "custom":
			<div class="text-xs opacity-50 text-center uppercase tracking-wider">{ it.Text }</div>
		}
	}
}

// DriverBadge renders inside #driver-badge; empty status clears it.
templ DriverBadge(status string) {
	if status != "" {
		<span class={ "badge badge-sm gap-1 shrink-0", badgeClass(status) }>
			<span class={ "status status-xs", statusColor(status) }></span>
			{ status }
		</span>
	}
}

// SearchBox is the in-transcript search row (V10). The island in main.ts
// counts matches in #chat and cycles them with the browser's own find, so
// multi-MB transcripts stay scroll-smooth.
templ SearchBox() {
	<details class="px-3">
		<summary class="text-sm opacity-60 select-none">Search</summary>
		<div class="flex items-center gap-2 pt-2">
			<input id="ts-input" type="search" placeholder="Find in transcript"
				class="input input-sm w-full rounded-xl bg-base-200"/>
			<span id="ts-count" class="text-xs opacity-60 tabular-nums whitespace-nowrap"></span>
			<button id="ts-prev" class="btn btn-sm btn-ghost rounded-full" type="button" aria-label="Previous match">&uarr;</button>
			<button id="ts-next" class="btn btn-sm btn-ghost rounded-full" type="button" aria-label="Next match">&darr;</button>
		</div>
	</details>
}

// ModelPicker (D2) sits above the composer. Sends pi's own editor
// commands, so a switch is exact and local: /model takes a pattern
// (provider/id, fuzzy fragment, optional :thinking suffix), /thinking
// takes one of pi's levels. Queued by pi when the agent is working.
templ ModelPicker(key string, current string) {
	<details class="collapse collapse-arrow bg-base-100/95 rounded-xl border border-base-300">
		<summary class="collapse-title text-sm py-1.5 min-h-0">
			Model <span class="opacity-50 font-mono text-xs">{ current }</span>
		</summary>
		<div class="collapse-content flex flex-col gap-2">
			<form method="post" action={ templ.URL("/sessions/" + key + "/model") } class="flex items-center gap-2">
				<input name="pattern" list="dl-models" required placeholder="provider/model[:thinking]" autocomplete="off"
					class="input input-sm w-full rounded-xl bg-base-200 font-mono"/>
				<datalist id="dl-models"></datalist>
				<button class="btn btn-sm rounded-xl" type="submit">Set</button>
			</form>
			<form method="post" action={ templ.URL("/sessions/" + key + "/thinking") } class="flex items-center gap-2">
				<select name="level" class="select select-sm w-full rounded-xl bg-base-200">
					<option value="off">thinking: off</option>
					<option value="minimal">minimal</option>
					<option value="low">low</option>
					<option value="medium" selected>medium</option>
					<option value="high">high</option>
					<option value="xhigh">xhigh</option>
					<option value="max">max</option>
				</select>
				<button class="btn btn-sm rounded-xl" type="submit">Set</button>
			</form>
		</div>
	</details>
}

// StopForm renders inside #stop-box. Ctrl-C on an idle pi prompt is
// destructive (it can exit pi), so the stop button exists only while the
// driver reports working or blocked. Close (D7) tears down the herdr
// workspace behind the session; the transcript file stays readable.
templ StopForm(key string, status string) {
	if status != "" {
		<div class="px-3 flex items-center gap-2">
			if status == "working" || status == "blocked" {
				<form method="post" action={ templ.URL("/sessions/" + key + "/stop") }>
					<button class="btn btn-error btn-sm rounded-full" type="submit">Stop (Ctrl-C)</button>
				</form>
			}
			<form method="post" action={ templ.URL("/sessions/" + key + "/close") } onsubmit="return confirm('Close this session in herdr? The pi agent exits.')">
				<button class="btn btn-outline btn-error btn-sm rounded-full" type="submit">Close session</button>
			</form>
		</div>
	}
}

func sseTranscript(key string) string {
	// The key lands inside a JS expression; strconv.Quote keeps a filename
	// with quotes or backslashes from breaking out.
	return "@get(" + strconv.Quote("/stream/transcript/"+url.PathEscape(key)) + ")"
}
