package pages

import (
	"path"
	"strings"

	"github.com/EstebanForge/couch-pi/internal/browse"
	"github.com/EstebanForge/couch-pi/internal/pi"
)

// Files is the lazy file tree (09): one directory level per page,
// navigation IS the lazy load. Preview cuts off per the spec.
templ Files(meta pi.SessionMeta, repo string, rel string, entries []browse.Entry) {
	<!doctype html>
	<html lang="en" data-theme="coffee">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ meta.DisplayName() } - files</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/coffee.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-3 pb-2">
				<a class="link link-hover text-sm opacity-60" href={ templ.URL("/sessions/" + meta.Key) }>&larr; Chat</a>
				<h1 class="text-xl font-bold truncate">{ meta.DisplayName() }</h1>
				if repo != "" {
					<p class="text-sm opacity-60 font-mono">{ path.Base(repo) }</p>
				}
			</header>
			@TabStrip(meta.Key, "files")
			<main class="px-3 pb-24">
				if repo == "" {
					<div class="alert alert-warning py-2 px-3 text-sm rounded-xl"><span>Not a git repository.</span></div>
				} else {
					<nav class="flex flex-wrap items-center gap-1 text-sm opacity-70 mb-3">
						<a class="link link-hover font-mono" href={ templ.URL("/sessions/" + meta.Key + "/files") }>{ path.Base(repo) }</a>
						@Crumbs(meta.Key, rel)
					</nav>
					<div class="flex flex-col gap-1">
						for _, e := range entries {
							if e.Dir {
								<div class="card bg-base-200 rounded-xl shadow-none">
									<a href={ templ.URL("/sessions/" + meta.Key + "/files?dir=" + rel + "/" + e.Name) } class="card-body p-2.5 flex-row items-center gap-2">
										<span class="size-7 shrink-0 rounded-lg bg-base-300 grid place-items-center text-xs">D</span>
										<span class="text-sm truncate">{ e.Name }/</span>
									</a>
								</div>
							} else {
								<div class="card bg-base-200/60 rounded-xl shadow-none">
									<a href={ templ.URL("/sessions/" + meta.Key + "/files/view?file=" + rel + "/" + e.Name) } class="card-body p-2.5 flex-row items-center gap-2">
										<span class="size-7 shrink-0"></span>
										<span class="text-sm font-mono truncate">{ e.Name }</span>
									</a>
								</div>
							}
						}
					</div>
				}
			</main>
		</body>
	</html>
}

templ Crumbs(key string, rel string) {
	for i, part := range splitRel(rel) {
		<span>/</span>
		<a class="link link-hover font-mono" href={ templ.URL("/sessions/" + key + "/files?dir=" + joinRel(splitRel(rel)[:i+1])) }>{ part }</a>
	}
}

// PreviewPage renders one file's text content.
templ PreviewPage(meta pi.SessionMeta, repo string, file string, content string, kind string) {
	<!doctype html>
	<html lang="en" data-theme="coffee">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ file }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/coffee.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-3 pb-2">
				<a class="link link-hover text-sm opacity-60" href={ templ.URL("/sessions/" + meta.Key + "/files?dir=" + path.Dir(file)) }>&larr; Files</a>
				<h1 class="text-sm font-mono font-semibold truncate">{ file }</h1>
			</header>
			@TabStrip(meta.Key, "files")
			<main class="px-3 pb-24">
				if kind == "binary" {
					<div class="alert alert-warning py-2 px-3 text-sm rounded-xl"><span>Binary file: no preview.</span></div>
				} else if kind == "toolarge" {
					<div class="alert alert-warning py-2 px-3 text-sm rounded-xl"><span>File over 2 MB: no preview.</span></div>
				} else {
					if kind == "partial" {
						<div class="alert alert-warning py-2 px-3 text-sm rounded-xl mb-2"><span>Preview cut at 256 KB.</span></div>
					}
					<pre class="diff bg-base-200 rounded-xl p-2 text-xs overflow-x-auto"><span class="dl meta">{ content }</span></pre>
				}
			</main>
		</body>
	</html>
}

func splitRel(rel string) []string {
	rel = path.Clean(rel)
	if rel == "." || rel == "/" {
		return nil
	}
	return strings.Split(strings.Trim(rel, "/"), "/")
}

func joinRel(parts []string) string {
	return path.Join(parts...)
}
