package pages

import (
	"github.com/EstebanForge/couch-pi/internal/web"
	"fmt"
	"path/filepath"
	"time"

	"github.com/EstebanForge/couch-pi/internal/pi"
)

templ List(sessions []pi.SessionMeta, badges map[string]string) {
	<!doctype html>
	<html lang="en" data-theme="dracula">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark light"/>
			<title>Couch Pi</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/dracula.css"/>
			<link rel="stylesheet" href={ web.AssetPath("/static/app.css") }/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script src="/static/js/datastar.js" defer></script>
			<script src={ web.AssetPath("/static/js/main.js") } defer></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-5 pb-2 flex items-end justify-between gap-2">
				<div class="min-w-0">
					<h1 class="text-2xl font-bold">Couch Pi</h1>
					<p class="sub text-sm opacity-60">{ fmt.Sprintf("%d sessions", len(sessions)) }</p>
				</div>
				<button id="push-btn" type="button" class="btn btn-ghost btn-sm rounded-full shrink-0" hidden>Notifications</button>
			</header>
			<main>
				<div id="session-list" data-on-load={ sseTarget() }>
					@SessionList(sessions, badges)
				</div>
			</main>
		</body>
	</html>
}

// SessionList is the live-patched fragment. The stream endpoint re-renders
// it into #session-list on every watcher tick and heartbeat.
templ SessionList(sessions []pi.SessionMeta, badges map[string]string) {
	<ul id="session-cards" class="flex flex-col gap-2 px-3 pb-24">
		for _, m := range sessions {
			<li>
				<a href={ templ.URL("/sessions/" + m.Key) } class="card bg-base-200 rounded-2xl shadow-none">
					<div class="card-body p-3 flex-row items-center gap-3">
						<div class="size-10 shrink-0 rounded-xl bg-base-300 grid place-items-center text-sm">&gt;_</div>
						<div class="min-w-0 flex-1">
							<div class="flex items-center gap-2">
								<span class="font-semibold truncate min-w-0">{ m.DisplayName() }</span>
								if status, ok := badges[m.Path]; ok {
									<span class={ "badge badge-sm gap-1 shrink-0", badgeClass(status) }>
										<span class={ "status status-xs", statusColor(status) }></span>
										{ status }
									</span>
								}
							</div>
							<div class="text-sm opacity-60 flex gap-2">
								<span class="truncate min-w-0">{ filepath.Base(m.Cwd) }</span>
								<span class="whitespace-nowrap shrink-0">{ ago(m.Mtime) }</span>
								if m.TotalTokens > 0 {
									<span class="whitespace-nowrap shrink-0">{ tok(m.TotalTokens) }</span>
								}
							</div>
						</div>
					</div>
				</a>
			</li>
		}
	</ul>
}

// badgeClass maps a herdr driver status to a daisyUI badge variant.
func badgeClass(status string) string {
	switch status {
	case "working":
		return "badge-info"
	case "done":
		return "badge-success"
	case "blocked":
		return "badge-warning"
	default:
		return "badge-ghost"
	}
}

// statusColor maps a herdr driver status to a daisyUI status dot color.
func statusColor(status string) string {
	switch status {
	case "working":
		return "status-info"
	case "done":
		return "status-success"
	case "blocked":
		return "status-warning"
	default:
		return ""
	}
}

func sseTarget() string {
	return `@get('/stream/sessions')`
}

func tok(n int64) string {
	switch {
	case n >= 1_000_000:
		return fmt.Sprintf("%.1fM tok", float64(n)/1e6)
	case n >= 1000:
		return fmt.Sprintf("%dk tok", n/1000)
	default:
		return fmt.Sprintf("%d tok", n)
	}
}

func ago(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	default:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	}
}
