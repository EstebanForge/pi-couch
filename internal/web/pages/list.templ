package pages

import (
	"fmt"
	"path/filepath"
	"time"

	"github.com/EstebanForge/piremote/internal/pi"
)

templ List(sessions []pi.SessionMeta, badges map[string]string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>PiRemote</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/js/datastar.js" defer></script>
		</head>
		<body>
			<header>
				<h1>PiRemote</h1>
				<p class="sub">{ fmt.Sprintf("%d sessions", len(sessions)) }</p>
			</header>
			<main>
				<div id="session-list" data-on-load={ sseTarget() }>
					@SessionList(sessions, badges)
				</div>
			</main>
		</body>
	</html>
}

// SessionList is the live-patched fragment. The stream endpoint re-renders
// it into #session-list on every watcher tick and heartbeat.
templ SessionList(sessions []pi.SessionMeta, badges map[string]string) {
	<ul class="sessions">
		for _, m := range sessions {
			<li>
				<a href={ templ.URL("/sessions/" + m.Key) }>
					<span class="name">{ m.DisplayName() }</span>
					if status, ok := badges[m.Path]; ok {
						<span class={ "badge", "b-" + status }>{ status }</span>
					}
					<span class="meta">
						<span>{ filepath.Base(m.Cwd) }</span>
						<span>{ ago(m.Mtime) }</span>
						if m.TotalTokens > 0 {
							<span>{ tok(m.TotalTokens) }</span>
						}
					</span>
				</a>
			</li>
		}
	</ul>
}

func sseTarget() string {
	return `@get('/stream/sessions')`
}

func tok(n int64) string {
	switch {
	case n >= 1_000_000:
		return fmt.Sprintf("%.1fM tok", float64(n)/1e6)
	case n >= 1000:
		return fmt.Sprintf("%dk tok", n/1000)
	default:
		return fmt.Sprintf("%d tok", n)
	}
}

func ago(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	default:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	}
}
