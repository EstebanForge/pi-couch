package pages

import (
	"github.com/EstebanForge/couch-pi/internal/web"
	"fmt"
	"path/filepath"
	"time"

	"github.com/EstebanForge/couch-pi/internal/pi"
)

templ List(sessions []pi.SessionMeta, badges map[string]string, total, w int) {
	<!doctype html>
	<html lang="en" data-theme="dracula">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark light"/>
			<meta name="theme-color" content="#0f1115"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<title>Couch Pi</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/daisyui.css" integrity="sha384-7aEtEHaaQlvolkHZ6DyoGlsNOFe/zuR0er02iYikX9npKr+C4ANk7t3C7wzeItRf" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/theme/dracula.css" integrity="sha384-5wuHXUrEEjdxHCFM30I9idvob9Li9ycYna0ziWfDPkAHDFijPEdeecw3xNvf4dzA" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ web.AssetPath("/static/app.css") }/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3" integrity="sha384-aJ9rL4k6lF+91guGvUFVSkpIcge7Zd9EiI4TQDLoK9kFaFJgKHgjEXVvG/qA5COj" crossorigin="anonymous"></script>
			<script src="/static/js/datastar.js" defer></script>
			<script src={ web.AssetPath("/static/js/main.js") } defer></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-5 pb-2 flex items-end justify-between gap-2">
				<div class="min-w-0">
					<h1 class="text-2xl font-bold">Couch Pi</h1>
					<p class="sub text-sm opacity-60">{ fmt.Sprintf("%d sessions", total) }</p>
				</div>
				<button id="push-btn" type="button" class="btn btn-ghost rounded-full shrink-0" hidden>Notifications</button>
			</header>
			<main>
				<div id="session-list" data-on-load={ sseTarget(w) }>
					@SessionList(sessions, badges, total, w)
				</div>
			</main>
		</body>
	</html>
}

// SessionList is the live-patched fragment. The stream endpoint re-renders
// it into #session-list on every watcher tick and heartbeat, windowed to
// the same slice the page rendered so pagination survives the stream.
templ SessionList(sessions []pi.SessionMeta, badges map[string]string, total, w int) {
	<ul id="session-cards" class="flex flex-col gap-2 px-3 pb-4">
		for i, m := range sessions {
			if i > 0 && active(badges[sessions[i-1].Path]) && !active(badges[m.Path]) {
				<li class="list-none">
					<div class="divider my-1 text-xs uppercase tracking-widest opacity-50">Earlier</div>
				</li>
			}
			if i == w-10 && w > 15 {
				// Anchor for the Load-more link: lands the viewport on the
				// first card of the freshly added batch.
				<li id="more" class="h-0"></li>
			}
			<li>
				<a href={ templ.URL("/sessions/" + m.Key) } class="card bg-base-200 rounded-2xl shadow-none">
					<div class="card-body p-3 flex-row items-center gap-3">
						<div class="size-10 shrink-0 rounded-xl bg-base-300 grid place-items-center text-sm">&gt;_</div>
						<div class="min-w-0 flex-1">
							<div class="flex items-center gap-2">
								<span class="font-semibold truncate min-w-0">{ m.DisplayName() }</span>
								if status, ok := badges[m.Path]; ok {
									<span class={ "badge badge-sm gap-1 shrink-0", badgeClass(status) }>
										<span class={ "status status-xs", statusColor(status) }></span>
										{ status }
									</span>
								}
							</div>
							<div class="text-sm opacity-60 flex gap-2">
								<span class="truncate min-w-0">{ filepath.Base(m.Cwd) }</span>
								<span class="whitespace-nowrap shrink-0">{ ago(m.Mtime) }</span>
								if m.TotalTokens > 0 {
									<span class="whitespace-nowrap shrink-0">{ tok(m.TotalTokens) }</span>
								}
							</div>
						</div>
					</div>
				</a>
			</li>
		}
	</ul>
	<div class="px-3 pb-24">
		if w < total {
			<a href={ templ.URL(fmt.Sprintf("/?w=%d#more", w+10)) } class="btn btn-ghost btn-block rounded-2xl bg-base-200">Load more</a>
		}
	</div>
}

// active reports a driving status: the sessions above the Earlier
// divider.
func active(status string) bool {
	return status == "working" || status == "blocked"
}

// badgeClass maps a herdr driver status to a daisyUI badge variant.
func badgeClass(status string) string {
	switch status {
	case "working":
		return "badge-info"
	case "done":
		return "badge-success"
	case "blocked":
		return "badge-warning"
	default:
		return "badge-ghost"
	}
}

// statusColor maps a herdr driver status to a daisyUI status dot color.
func statusColor(status string) string {
	switch status {
	case "working":
		return "status-info"
	case "done":
		return "status-success"
	case "blocked":
		return "status-warning"
	default:
		return ""
	}
}

func sseTarget(w int) string {
	return fmt.Sprintf(`@get('/stream/sessions?w=%d')`, w)
}

func tok(n int64) string {
	switch {
	case n >= 1_000_000:
		return fmt.Sprintf("%.1fM tok", float64(n)/1e6)
	case n >= 1000:
		return fmt.Sprintf("%dk tok", n/1000)
	default:
		return fmt.Sprintf("%d tok", n)
	}
}

func ago(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	default:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	}
}
