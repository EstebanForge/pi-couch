package pages

import (
	"github.com/EstebanForge/couch-pi/internal/web"
	"fmt"
	"path/filepath"
	"time"

	"github.com/EstebanForge/couch-pi/internal/pi"
	"github.com/EstebanForge/couch-pi/internal/store"
)

// Comments is the Cmts tab. Pending comments live on the device and render
// by the island; sent comments come from server state (R5/R6).
templ Comments(meta pi.SessionMeta, sent []store.Comment) {
	<!doctype html>
	<html lang="en" data-theme="dracula">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ meta.DisplayName() } - comments</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/daisyui.css" integrity="sha384-7aEtEHaaQlvolkHZ6DyoGlsNOFe/zuR0er02iYikX9npKr+C4ANk7t3C7wzeItRf" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5.7.47/theme/dracula.css" integrity="sha384-5wuHXUrEEjdxHCFM30I9idvob9Li9ycYna0ziWfDPkAHDFijPEdeecw3xNvf4dzA" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ web.AssetPath("/static/app.css") }/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3" integrity="sha384-aJ9rL4k6lF+91guGvUFVSkpIcge7Zd9EiI4TQDLoK9kFaFJgKHgjEXVvG/qA5COj" crossorigin="anonymous"></script>
			<script src={ web.AssetPath("/static/js/main.js") } defer></script>
		</head>
		<body class="bg-base-100 text-base-content">
			<header class="px-4 pt-3 pb-2">
				<a class="link link-hover text-sm opacity-60" href={ templ.URL("/sessions/" + meta.Key) }>&larr; Chat</a>
				<h1 class="text-xl font-bold truncate">{ meta.DisplayName() }</h1>
				<p class="text-sm opacity-60 font-mono">{ filepath.Base(meta.Cwd) }</p>
			</header>
			@TabStrip(meta.Key, "cmts")
			<main class="px-3 pb-24" id="cmt-app" data-key={ meta.Key }>
				<section id="cmt-pending"></section>
				<h2 class="text-sm font-semibold uppercase tracking-wider opacity-60 mt-4 mb-2">Sent</h2>
				if len(sent) == 0 {
					<p class="text-sm opacity-60">No sent comments yet. Tap a diff line on the Changes tab.</p>
				}
				for _, c := range sent {
					<div class="card bg-base-200 rounded-xl shadow-none mb-2">
						<div class="card-body p-3">
							<div class="text-xs opacity-60 flex justify-between mb-1">
								<span class="font-mono">{ fmt.Sprintf("%s:%d", c.File, c.Line) }</span>
								<span>{ time.Unix(c.TS, 0).Format("Jan 2 15:04") }</span>
							</div>
							<p class="text-sm whitespace-pre-wrap">{ c.Body }</p>
						</div>
					</div>
				}
			</main>
		</body>
	</html>
}
