package pages

// TabStrip renders the five-tab bar. All five link out; every tab is live.
templ TabStrip(key string, active string) {
	<nav class="tabs">
		<a href={ templ.URL("/sessions/" + key) } class={ "tab", templ.KV("active", active == "chat") }>Chat</a>
		<a href={ templ.URL("/sessions/" + key + "/changes") } class={ "tab", templ.KV("active", active == "chg") }>Chg</a>
		<a href={ templ.URL("/sessions/" + key + "/terminal") } class={ "tab", templ.KV("active", active == "term") }>Term</a>
		<a href={ templ.URL("/sessions/" + key + "/files") } class={ "tab", templ.KV("active", active == "files") }>Files</a>
		<a href={ templ.URL("/sessions/" + key + "/comments") } class={ "tab", templ.KV("active", active == "cmts") }>Cmts</a>
	</nav>
}
