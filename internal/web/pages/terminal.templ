package pages

import "github.com/EstebanForge/couch-pi/internal/pi"

// Terminal is the peek-by-default terminal tab (T4). Take-the-wheel and
// the key row live in the main.js island; the stream is raw SSE.
templ Terminal(meta pi.SessionMeta, driver string) {
	<!doctype html>
	<html lang="en" data-theme="coffee">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ meta.DisplayName() } - terminal</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/coffee.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<link rel="stylesheet" href="/static/css/xterm.css"/>
			<script src="/static/js/vendor/xterm.js"></script>
			<script src="/static/js/vendor/xterm-addon-fit.js"></script>
			<script src="/static/js/main.js" defer></script>
		</head>
		<body class="bg-base-100 text-base-content overflow-x-hidden">
			<header class="px-4 pt-3 pb-2">
				<a class="link link-hover text-sm opacity-60" href={ templ.URL("/sessions/" + meta.Key) }>&larr; Chat</a>
				<div class="flex items-center gap-2">
					<h1 class="text-xl font-bold truncate min-w-0 flex-1">{ meta.DisplayName() }</h1>
					<span id="driver-badge" class="shrink-0">@DriverBadge(driver)</span>
				</div>
			</header>
			@TabStrip(meta.Key, "term")
			<div id="term" data-key={ meta.Key }></div>
			<div id="keyrow">
				<button data-keys="esc">Esc</button>
				<button data-keys="ctrl+c">C-C</button>
				<button data-keys="tab">Tab</button>
				<button data-keys="enter">&crarr;</button>
				<button data-keys="up">&uarr;</button>
				<button data-keys="down">&darr;</button>
				<button data-keys="left">&larr;</button>
				<button data-keys="right">&rarr;</button>
				<button id="wheel-btn">Take the wheel</button>
			</div>
		</body>
	</html>
}
